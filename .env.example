# JD-Relay's webhook is bound to 127.0.0.1:8787 with no public HTTP -- this
# only works when JD-Watch runs on the same VM as jd-relay.service.
JD_RELAY_URL=http://127.0.0.1:8787
JD_RELAY_SECRET=

# Same bot token JD-Signal's ops_monitor.py already posts with -- reusing
# DISCORD_OPS_CHANNEL_ID conventions rather than standing up new channels.
DISCORD_BOT_TOKEN=
DISCORD_OPS_CHANNEL_ID=

# Sibling-directory convention already used by ops_monitor.py's
# JD_RELAY_DIR = JD_SIGNAL_DIR.parent / "JD-Relay". JD_SIGNAL_PYTHON should
# point at JD-Signal's own venv python (its own deps, not JD-Watch's).
JD_SIGNAL_REPO_PATH=/home/knbnagendra_gmail_com/JD-Signal
JD_SIGNAL_PYTHON=/home/knbnagendra_gmail_com/JD-Signal/venv/bin/python3

STORE_PATH=jd_watch.db
WATCH_CONFIG_PATH=watch.yaml
